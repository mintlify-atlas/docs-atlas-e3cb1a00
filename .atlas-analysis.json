  "keyFeatures": [
    "Sub-60ms cold start using resource pool pre-provisioning and snapshot cloning",
    "Hardware-level isolation with dedicated OS kernel per sandbox (KVM MicroVMs)",
    "E2B SDK drop-in compatibility — swap one environment variable to migrate",
    "Ultra-low per-instance memory overhead (<5MB) enabling thousands of sandboxes per node",
    "eBPF-based CubeVS for kernel-level network isolation and egress policy enforcement",
    "Single-node and multi-node cluster deployment with one-click installer",
    "Rust-built CubeAPI gateway with E2B-compatible REST interface",
    "Sandbox pause/resume and state checkpoint support (snapshotting)"
  ],
  "publicApiSurface": [
    "GET /cubeapi/v1/health",
    "GET /cubeapi/v1/v2/sandboxes",
